{% extends 'base.html.twig' %}

{% block title %}Ville{% endblock %}

{% block body %}
<div class="container">
    <br>
    <h1>Ville</h1>
    <br>
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ city.id }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ city.name }}</td>
            </tr>
            <tr>
                <th>Code postal</th>
                <td>{{ city.zipCode }}</td>
            </tr>
            <tr>
                <th>Frais de port</th>
                <td>{{ city.shippingCost }} €</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-outline-primary" href="{{ path('app_city_edit', {'id': city.id}) }}">Modifier</a>
    <br><br>
    {{ include('city/_delete_form.html.twig') }}
    <br>
    <a class="btn btn-dark" href="{{ path('app_city_index') }}">Retour</a>
</div>
{% endblock %}
